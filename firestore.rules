rules_version = '2';

// Zelfde Firebase-project als startlijst.teamendurance.nl — dit bestand
// vervangt de volledige regels in de Firebase Console (Firestore > Rules),
// dus het bevat ook de "invites"-regel die de Startlijst al gebruikte.
//
// Overal geldt: iedereen met de link mag lezen, alleen wie is ingelogd
// met het gedeelde wachtwoord (via Firebase Authentication) mag schrijven.
service cloud.firestore {
  match /databases/{database}/documents {
    match /invites/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /finance/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /training/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
