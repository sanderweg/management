rules_version = '2';

// Zelfde Firebase-project als startlijst.teamendurance.nl — dit bestand
// vervangt de volledige regels in de Firebase Console (Firestore > Rules),
// dus het bevat ook de "invites"-regel die de Startlijst al gebruikte.
//
// "invites" (de Startlijst) blijft voor iedereen leesbaar — dat was al zo
// en de Startlijst toont toch al aan iedereen wie heeft betaald.
// "finance" en "training" zijn gevoeliger: daar is zowel lezen als
// schrijven alleen mogelijk voor wie is ingelogd met het gedeelde
// wachtwoord (via Firebase Authentication).
service cloud.firestore {
  match /databases/{database}/documents {
    match /invites/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /finance/{docId} {
      allow read, write: if request.auth != null;
    }
    match /training/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
